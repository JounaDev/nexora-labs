{
  "name": "nexora-labs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "npm run generate --workspace=@nexora/database",
    "db:migrate": "npm run migrate --workspace=@nexora/database",
    "db:reset": "prisma migrate reset --schema=packages/database/schema.prisma",
    "db:seed": "npm run seed --workspace=@nexora/database",
    "db:studio": "npm run studio --workspace=@nexora/database"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@10.8.2",
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "prisma@5.22.0": true,
    "sharp@0.34.5": true
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "three": "^0.185.1"
  }
}
